{
  "name": "dsh-personal-skill-manager",
  "version": "0.6.0",
  "private": true,
  "description": "Personal skill library for DeepSeek Harness. Written skills live in skills/ and are distributed; favorites store only community source metadata.",
  "type": "module",
  "license": "MIT",
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "skill", "personal"],
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
