{
  "name": "@zhyq0826/dsh-personal-skill-manager",
  "version": "0.6.0",
  "description": "Personal skill library for DeepSeek Harness. Written skills live in skills/ and are distributed; favorites store only community source metadata.",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skill",
    "skills",
    "personal"
  ],
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./icon-dark": "./icon-dark.svg"
  },
  "files": [
    "index.js",
    "dist/client.js",
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "AGENTS.md",
    "PLUGIN.md",
    "PLUGIN.zh-CN.md",
    "LICENSE",
    "icon-dark.svg"
  ],
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm test",
    "pack:check": "npm pack --dry-run",
    "release": "node scripts/release.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhyq0826/dsh-personal-skill-manager.git"
  },
  "homepage": "https://github.com/zhyq0826/dsh-personal-skill-manager#readme",
  "bugs": {
    "url": "https://github.com/zhyq0826/dsh-personal-skill-manager/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "author": {
    "name": "zhyq0826",
    "url": "https://www.npmjs.com/~zhyq0826"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "esbuild": "0.25.12",
    "playwright-core": "1.61.1",
    "react": "18.3.1",
    "typescript": "5.9.3"
  }
}
